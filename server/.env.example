# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real credentials.

# Optional — defaults to 4000 if unset.
# PORT=4000

# Email backup (General Settings > Backup > "Email backup now").
# GMAIL_USER: the Gmail account that sends the backup email.
# GMAIL_APP_PASSWORD: an App Password for that account (NOT its normal
#   login password) — generate one at https://myaccount.google.com/apppasswords
#   (requires 2-Step Verification to be turned on for the account).
# BACKUP_EMAIL_TO: where the backup gets sent, comma-separated for more
#   than one address.
GMAIL_USER=
GMAIL_APP_PASSWORD=
BACKUP_EMAIL_TO=
