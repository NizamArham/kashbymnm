# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real credentials.

# Optional — defaults to 4000 if unset.
# PORT=4000

# Email backup (General Settings > Backup > "Email backup now").
# GMAIL_USER: the Gmail account that sends the backup email.
# GMAIL_APP_PASSWORD: an App Password for that account (NOT its normal
#   login password) — generate one at https://myaccount.google.com/apppasswords
#   (requires 2-Step Verification to be turned on for the account).
# BACKUP_EMAIL_TO: where the backup gets sent, comma-separated for more
#   than one address.
GMAIL_USER=
GMAIL_APP_PASSWORD=
BACKUP_EMAIL_TO=

# CityPak courier API — not wired into any code yet, these are just
# stored for when that integration gets built. CITYPAK_BASE_URL is the
# API host (per their API docs), not the client-panel login URL.
# CITYPAK_PANEL_USERNAME/PASSWORD are the client-panel login (for
# reference only, unused by the API); CITYPAK_API_TOKEN is the actual
# API credential, sent as a Bearer token.
CITYPAK_BASE_URL=
CITYPAK_ACCOUNT_NUMBER=
CITYPAK_PANEL_USERNAME=
CITYPAK_PANEL_PASSWORD=
CITYPAK_API_TOKEN=

# Fardar Express Domestic courier API — used by "Create shipment with
# Fardar" on the Deliveries page's waybill window. Client ID and API key
# are on Fardar's "YOUR API INFORMATION" panel. FARDAR_BASE_URL is only
# for pointing at a test server; leave it blank to use their live API.
FARDAR_CLIENT_ID=
FARDAR_API_KEY=
FARDAR_BASE_URL=

# Fardar sends delivery status updates to us (a "callback"). Pick any long
# random string for FARDAR_WEBHOOK_SECRET, then give Fardar this as the
# endpoint URL (the server must be reachable from the internet):
#   https://YOUR-PUBLIC-ADDRESS/api/webhooks/fardar/<the secret>
# Without a secret set, the callback address refuses everything.
FARDAR_WEBHOOK_SECRET=

# The fixed public address of the tunnel Fardar's callbacks arrive through
# (ngrok's free static domain, e.g. your-name.ngrok-free.app — no https://).
# Start it with: npm run tunnel      Show the URL to give Fardar: npm run tunnel:url
NGROK_DOMAIN=
